<script>
const $=s=>document.querySelector(s);
const opened=new Map();
const sel=new Map();
let last=null;
const el=(t,a,...k)=>{const e=document.createElement(t);for(const[n,v]of Object.entries(a||{})){if(n==='class')e.className=v;else if(n==='disabled'){if(v)e.disabled=true}else if(n.startsWith('on'))e.addEventListener(n.slice(2),v);else e.setAttribute(n,v)}e.append(...k.filter(x=>x!=null&&x!==false));return e};
const api=async(p,b)=>{const r=await fetch(p,b?{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)}:{});if(!r.ok)throw new Error(r.status);return r};
const ago=s=>{s=Math.max(0,Math.round(s));if(s<60)return s+'s ago';if(s<3600)return Math.floor(s/60)+'m ago';if(s<86400)return Math.floor(s/3600)+'h ago';return Math.floor(s/86400)+'d ago'};
const act=async(p,b)=>{try{await api(p,b)}catch(e){alert('Request failed: '+e.message)}if(document.activeElement)document.activeElement.blur();load()};
const KINDS={pacman:'Pacman',apt:'APT',aur:'AUR (yay)',docker:'Docker images'};

const doCheck=async e=>{
  e.preventDefault();
  const inp=$('#check-inp'),btn=$('#check-btn'),resBox=$('#check-result');
  const val=inp.value.trim();
  if(!val)return;
  btn.disabled=true;btn.textContent='Checking...';
  resBox.hidden=false;
  resBox.innerHTML='<span class="mut">Probing '+val+'...</span>';
  try{
    const r=await api('/api/check',{target:val});
    const d=await r.json();
    const isOk=d.matched_hosts&&d.matched_hosts.length;
    const isRej=d.recent_rejections&&d.recent_rejections.length;
    const isReachable=d.ping_ok||(d.open_ports&&d.open_ports.length);
    const color=isOk?'var(--ok)':(isRej?'var(--bad)':(isReachable?'var(--warn)':'var(--bad)'));
    let html='<div style="margin-bottom:4px"><strong>Result:</strong> <span style="color:'+color+'">'+d.summary+'</span></div>';
    if(d.advice)html+='<div class="mut" style="margin-top:4px"><strong>Tip:</strong> '+d.advice+'</div>';
    resBox.innerHTML=html;
  }catch(err){
    resBox.innerHTML='<span style="color:var(--bad)">Check failed: '+err.message+'</span>';
  }finally{
    btn.disabled=false;btn.textContent='Check';
  }
};

function holds(host,list){
  const inp=el('input',{placeholder:'package name',maxlength:'128',autocomplete:'off'});
  const form=el('form',{class:'add',onsubmit:e=>{e.preventDefault();const p=inp.value.trim();if(p)act('/api/hold',{host,pkg:p,on:true})}},inp,el('button',{type:'submit'},'Hold'));
  return el('div',{class:'holds'},
    ...list.map(p=>el('span',{class:'chip'},p,el('button',{title:'release',onclick:()=>act('/api/hold',{host,pkg:p,on:false})},'×'))),
    form);
}
function det(key,dflt,sum,body,ontoggle){
  const d=el('details',{},el('summary',{},sum),body);
  d.open=opened.has(key)?opened.get(key):dflt;
  d.addEventListener('toggle',()=>{opened.set(key,d.open);if(ontoggle)ontoggle(d)});
  return d;
}
function pendingBlock(h,held,set){
  const wrap=el('div',{class:'pend'});
  for(const kind of Object.keys(KINDS)){
    const items=h.pending.filter(p=>p.kind===kind);
    if(!items.length)continue;
    const keys=items.map(p=>kind+'\t'+p.name);
    const master=el('input',{type:'checkbox',title:'select all',onchange:e=>{keys.forEach(k=>e.target.checked?set.add(k):set.delete(k));render(last)}});
    master.checked=keys.every(k=>set.has(k));
    wrap.append(el('div',{class:'grp'},master,KINDS[kind]+' ('+items.length+')'));
    for(const p of items){
      const k=kind+'\t'+p.name;
      const cb=el('input',{type:'checkbox',onchange:e=>{e.target.checked?set.add(k):set.delete(k);render(last)}});
      cb.checked=set.has(k);
      wrap.append(el('label',{class:'row'+(held.has(p.name)?' held':'')},cb,el('span',{class:'nm'},p.name),el('span',{class:'d'},p.detail)));
    }
  }
  return wrap;
}
function hostCard(h,s){
  const age=s.now-h.last_seen;
  const state=(h.status==='running'&&age<3600)?'running':age<60?'online':'offline';
  const held=new Set([...s.global,...h.holds]);
  const set=sel.get(h.name)||new Set();sel.set(h.name,set);
  const keys=new Set(h.pending.map(p=>p.kind+'\t'+p.name));
  for(const k of [...set])if(!keys.has(k))set.delete(k);
  const counts=Object.keys(KINDS).map(k=>[k,h.pending.filter(p=>p.kind===k).length]).filter(x=>x[1]).map(x=>x[1]+' '+x[0]).join(', ');
  const busy=state==='running'||h.run_requested;
  const runSel=()=>{
    const items=[...set].map(k=>{const[kind,name]=k.split('\t');return{kind,name}});
    const pm=items.filter(i=>i.kind==='pacman').length,all=h.pending.filter(p=>p.kind==='pacman').length;
    if(pm&&pm<all&&!confirm('Updating only some pacman packages is a partial upgrade. Arch does not support that and it can break the system. Continue?'))return;
    set.clear();act('/api/run',{host:h.name,items});
  };
  const pend=h.pending.length?det('p:'+h.name,true,h.pending.length+' pending: '+counts,pendingBlock(h,held,set)):el('div',{class:'lbl'},'Up to date');
  const pre=el('pre',{},'loading...');
  const loadLog=()=>fetch('/api/log?host='+encodeURIComponent(h.name)).then(r=>r.text()).then(t=>{pre.textContent=t||'(empty)'}).catch(()=>{pre.textContent='failed to load'});
  const logSum='Last run: '+(h.last_result?h.last_result+', '+ago(s.now-h.last_run):'never');
  return el('section',{class:'card'},
    el('div',{class:'head'},
      el('h2',{},h.name),
      h.ip?el('span',{class:'mut',style:'font-size:12px;font-family:monospace'},'('+h.ip+')'):null,
      el('span',{class:'badge '+state},state),el('span',{class:'mut'},'seen '+ago(age)),el('span',{class:'sp'}),
      el('button',{disabled:busy||!set.size,onclick:runSel},h.run_requested&&h.queued?'Queued...':'Update selected ('+set.size+')'),
      el('button',{class:'pri',title:"Runs the COMMANDS from the server's config",disabled:busy,onclick:()=>act('/api/run',{host:h.name})},h.run_requested&&!h.queued?'Queued...':'Update all'),
      state==='offline'?el('button',{onclick:()=>{if(confirm('Remove '+h.name+'?'))act('/api/delete',{host:h.name})}},'Remove'):null),
    pend,
    el('div',{class:'lbl'},'Held on this server'),holds(h.name,h.holds),
    h.has_log?det('l:'+h.name,false,logSum,pre,d=>{if(d.open)loadLog()}):el('div',{class:'lbl'},logSum));
}
function render(s){
  last=s;
  const alertBox=$('#alerts');
  if(s.rejections&&s.rejections.length){
    const r=s.rejections[s.rejections.length-1];
    alertBox.innerHTML='<div class="alert">⚠️ Connection rejected from <strong>'+r.ip+'</strong> ('+r.reason+': '+r.detail+') '+ago(s.now-r.time)+'. Ensure TOKEN in /etc/next-update-server/config matches this web UI.</div>';
  }else{
    alertBox.innerHTML='';
  }
  const emptyHelp='No servers linked yet. To connect, set WEB_URL="http://127.0.0.1:'+s.server_info.port+'" (for this machine) or with this machine\'s LAN IP (for remote servers) and matching TOKEN in /etc/next-update-server/config, then restart next-update-server.';
  $('#app').replaceChildren(
    el('section',{class:'card'},el('h2',{},'Held on all servers'),el('div',{class:'lbl'},'Skipped on every server (pacman --ignore, apt hold during the run).'),holds('',s.global)),
    ...(s.hosts.length?s.hosts.map(h=>hostCard(h,s)):[el('p',{class:'mut'},emptyHelp)]));
}
async function load(){
  const a=document.activeElement;if(a&&a.tagName==='INPUT'&&a.type==='text')return;
  try{render(await(await api('/api/state')).json());$('#err').hidden=true}catch(e){$('#err').hidden=false}
}
setInterval(load,5000);load();
