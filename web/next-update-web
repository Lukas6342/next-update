class DualStackServer(ThreadingHTTPServer):
    address_family = socket.AF_INET6

    def server_bind(self):
        try:
            self.socket.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
        except (AttributeError, OSError):
            pass
        super().server_bind()


def main():
    if not ADMIN_USER or not ADMIN_PASSWORD or not TOKEN:
        sys.exit("ADMIN_USER, ADMIN_PASSWORD and TOKEN must be set in /etc/next-update-web/config")
    init_db()

    srv = None
    if LISTEN in ("0.0.0.0", "::"):
        try:
            srv = DualStackServer(("::", PORT), Handler)
            print("listening on [::]:%d (dual-stack IPv4/IPv6)" % PORT, flush=True)
        except Exception:
            srv = None

    if srv is None:
        try:
            srv = ThreadingHTTPServer((LISTEN, PORT), Handler)
            print("listening on %s:%d" % (LISTEN, PORT), flush=True)
        except Exception as e:
            sys.exit("Failed to bind on %s:%d: %s" % (LISTEN, PORT, e))

    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
