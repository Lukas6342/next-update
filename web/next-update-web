#!/usr/bin/env python3
"""next-update-web - modern central web UI for next-update-server daemons (stdlib only)."""
import base64
import hmac
import json
import os
import re
import secrets
import socket
import sqlite3
import subprocess
import sys
import time
from contextlib import contextmanager
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

LISTEN = os.environ.get("LISTEN", "0.0.0.0").strip().strip("'\"")
PORT = int(os.environ.get("PORT", "8080").strip().strip("'\""))
ADMIN_USER = os.environ.get("ADMIN_USER", "").strip().strip("'\"")
ADMIN_PASSWORD = os.environ.get("ADMIN_PASSWORD", "").strip().strip("'\"")
TOKEN = os.environ.get("TOKEN", "").strip().strip("'\"")
DB_FILE = os.path.join(os.environ.get("STATE_DIRECTORY", ".").strip().strip("'\""), "state.db")
MAX_BODY = 1 << 20
HOST_RE = re.compile(r"^[A-Za-z0-9._-]{1,64}$")
PKG_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9@._+:-]{0,127}$")
IMG_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/:-]{0,254}$")
KINDS = ("pacman", "apt", "aur", "docker")

REJECTIONS = []  # list of {"time": float, "ip": str, "reason": str, "detail": str}


def record_rejection(ip, reason, detail=""):
    REJECTIONS.append({
        "time": time.time(),
        "ip": ip,
        "reason": reason,
        "detail": detail
    })
    if len(REJECTIONS) > 50:
        REJECTIONS.pop(0)


@contextmanager
def conn():
    c = sqlite3.connect(DB_FILE, timeout=10)
    c.row_factory = sqlite3.Row
    try:
        with c:
            yield c
    finally:
        c.close()


def init_db():
    with conn() as c:
        c.executescript(
            """
            CREATE TABLE IF NOT EXISTS hosts(
                name TEXT PRIMARY KEY, last_seen REAL, status TEXT, pending TEXT,
                run_requested INTEGER NOT NULL DEFAULT 0, run_items TEXT,
                last_run REAL, last_result TEXT, last_log TEXT, ip TEXT);
            CREATE TABLE IF NOT EXISTS holds(
                host TEXT NOT NULL, pkg TEXT NOT NULL, PRIMARY KEY(host, pkg));
            CREATE TABLE IF NOT EXISTS sessions(
                token TEXT PRIMARY KEY, created_at REAL, user TEXT);
            """
        )
        cols = [r["name"] for r in c.execute("PRAGMA table_info(hosts)")]
        if "run_items" not in cols:
            c.execute("ALTER TABLE hosts ADD COLUMN run_items TEXT")
        if "ip" not in cols:
            c.execute("ALTER TABLE hosts ADD COLUMN ip TEXT")


def parse_pending(text):
    out = []
    for line in (text or "").splitlines():
        p = line.split("\t", 2)
        if len(p) >= 2 and p[0] in KINDS:
            out.append({"kind": p[0], "name": p[1], "detail": p[2] if len(p) > 2 else ""})
    return out


def state():
    now = time.time()
    with conn() as c:
        hosts = [dict(r) for r in c.execute(
            "SELECT name,last_seen,status,pending,run_requested,run_items,last_run,last_result,ip,"
            "last_log IS NOT NULL AND last_log != '' AS has_log FROM hosts ORDER BY name")]
        holds = {}
        for r in c.execute("SELECT host,pkg FROM holds ORDER BY pkg"):
            holds.setdefault(r["host"], []).append(r["pkg"])
    for h in hosts:
        h["pending"] = parse_pending(h["pending"])
        h["queued"] = len((h.pop("run_items") or "").splitlines())   # 0 = full run
        h["holds"] = holds.get(h["name"], [])
    recent_rej = [r for r in REJECTIONS if now - r["time"] < 900]
    return {
        "now": now,
        "global": holds.get("", []),
        "hosts": hosts,
        "rejections": recent_rej,
        "server_info": {"listen": LISTEN, "port": PORT, "user": ADMIN_USER}
    }


def agent_poll(host, status, pending, client_ip):
    with conn() as c:
        c.execute(
            "INSERT INTO hosts(name,last_seen,status,pending,ip) VALUES(?,?,?,?,?) "
            "ON CONFLICT(name) DO UPDATE SET last_seen=excluded.last_seen,"
            "status=excluded.status,pending=excluded.pending,ip=excluded.ip",
            (host, time.time(), status, pending[:262144], client_ip))
        row = c.execute("SELECT run_requested,run_items FROM hosts WHERE name=?", (host,)).fetchone()
        run = bool(row["run_requested"]) and status != "running"   # nothing is handed out mid-run
        if run:
            c.execute("UPDATE hosts SET run_requested=0, run_items=NULL WHERE name=?", (host,))
        pkgs = [r[0] for r in c.execute(
            "SELECT DISTINCT pkg FROM holds WHERE host IN ('', ?) ORDER BY pkg", (host,))]
    out = "".join("hold %s\n" % p for p in pkgs)
    if run:
        items = (row["run_items"] or "").splitlines()
        out += ("runsel\n" + "".join("item %s\n" % i for i in items)) if items else "run\n"
    return out


def agent_log(host, result, text):
    with conn() as c:
        c.execute("UPDATE hosts SET last_run=?, last_result=?, last_log=? WHERE name=?",
                  (time.time(), result, text, host))


def valid_item(it):
    if not isinstance(it, dict):
        return False
    kind, name = it.get("kind"), it.get("name")
    if not isinstance(name, str):
        return False
    return bool((kind in ("pacman", "apt", "aur") and PKG_RE.match(name)) or (kind == "docker" and IMG_RE.match(name)))


def check_target(raw_target, default_port=8080):
    raw_target = (raw_target or "").strip()
    if raw_target.startswith("http://"):
        raw_target = raw_target[7:]
    elif raw_target.startswith("https://"):
        raw_target = raw_target[8:]
    raw_target = raw_target.split("/")[0]

    custom_port = None
    if ":" in raw_target and not raw_target.startswith("["):
        host, _, p = raw_target.partition(":")
        if p.isdigit():
            raw_target = host
            custom_port = int(p)
    elif raw_target.startswith("[") and "]" in raw_target:
        host = raw_target[1:raw_target.index("]")]
        rest = raw_target[raw_target.index("]") + 1:]
        if rest.startswith(":") and rest[1:].isdigit():
            custom_port = int(rest[1:])
        raw_target = host

    target = raw_target
    now = time.time()
    result = {
        "target": target,
        "resolved_ip": target,
        "is_local": False,
        "ping_ok": False,
        "open_ports": [],
        "matched_hosts": [],
        "recent_rejections": [],
        "summary": "",
        "advice": ""
    }

    if not target:
        result["summary"] = "No IP or hostname provided."
        return result

    try:
        addrinfo = socket.getaddrinfo(target, None)
        resolved_ips = list(dict.fromkeys(a[4][0] for a in addrinfo))
        if resolved_ips:
            result["resolved_ip"] = resolved_ips[0]
    except Exception:
        result["resolved_ip"] = target

    target_ips = set(filter(None, [target, result["resolved_ip"]]))

    local_candidates = {"127.0.0.1", "::1", "localhost", "0.0.0.0"}
    try:
        my_hostname = socket.gethostname()
        local_candidates.add(my_hostname)
        for a in socket.getaddrinfo(my_hostname, None):
            local_candidates.add(a[4][0])
    except Exception:
        pass

    if target in local_candidates or result["resolved_ip"] in local_candidates:
        result["is_local"] = True

    # Check known hosts in database
    with conn() as c:
        for r in c.execute("SELECT name, ip, status, last_seen FROM hosts"):
            if r["ip"] in target_ips or r["name"].lower() == target.lower():
                seen_ago = round(now - (r["last_seen"] or 0))
                result["matched_hosts"].append({
                    "name": r["name"],
                    "ip": r["ip"],
                    "status": r["status"],
                    "seen_ago": seen_ago
                })

    # Check recent rejections
    for r in REJECTIONS:
        if (r["ip"] in target_ips or target in r["ip"]) and now - r["time"] < 3600:
            result["recent_rejections"].append({
                "time_ago": round(now - r["time"]),
                "reason": r["reason"],
                "detail": r["detail"]
            })

    # Fast ICMP Ping test (timeout 1.5s)
    try:
        cmd = ["ping", "-c", "1", "-W", "1", result["resolved_ip"]]
        res = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1.5)
        if res.returncode == 0:
            result["ping_ok"] = True
    except Exception:
        pass

    # Check common ports: SSH (22), Web (default_port), HTTP (80), HTTPS (443)
    probe_ports = [22, default_port, 80, 443]
    if custom_port and custom_port not in probe_ports:
        probe_ports.insert(0, custom_port)

    is_ipv6 = ":" in result["resolved_ip"]
    af = socket.AF_INET6 if is_ipv6 else socket.AF_INET

    for p in probe_ports:
        try:
            s = socket.socket(af, socket.SOCK_STREAM)
            s.settimeout(0.5)
            rc = s.connect_ex((result["resolved_ip"], p))
            s.close()
            if rc == 0:
                result["open_ports"].append(p)
        except Exception:
            pass

    # Build human-readable summary and advice
    if result["matched_hosts"]:
        h = result["matched_hosts"][0]
        status_str = "online" if h["seen_ago"] < 60 else ("running" if h["status"] == "running" else "offline")
        result["summary"] = f"Server '{h['name']}' is linked ({h['ip'] or target}, last seen {h['seen_ago']}s ago, {status_str})."
        result["advice"] = "The daemon is actively communicating with this web UI."
    elif result["recent_rejections"]:
        rej = result["recent_rejections"][-1]
        result["summary"] = f"Connection attempted from this IP {rej['time_ago']}s ago, but was REJECTED ({rej['reason']}: {rej['detail']})!"
        result["advice"] = "Check that TOKEN in /etc/next-update-server/config on that machine matches TOKEN in /etc/next-update-web/config."
    elif result["ping_ok"] or result["open_ports"]:
        details = []
        if result["ping_ok"]:
            details.append("ping responded")
        if result["open_ports"]:
            details.append("open ports: " + ", ".join(str(p) for p in result["open_ports"]))
        result["summary"] = f"Host {target} is REACHABLE ({', '.join(details)}), but next-update-server is not linked yet."
        if result["is_local"]:
            result["advice"] = f"This is the local machine. In /etc/next-update-server/config set WEB_URL=\"http://127.0.0.1:{default_port}\" and matching TOKEN, then run: sudo systemctl restart next-update-server."
        else:
            result["advice"] = f"On that server, edit /etc/next-update-server/config: set WEB_URL=\"http://<web-ip>:{default_port}\" and matching TOKEN, then run: sudo systemctl restart next-update-server."
    elif result["is_local"]:
        result["summary"] = f"{target} is the local machine, but next-update-server has not checked in yet."
        result["advice"] = f"Set WEB_URL=\"http://127.0.0.1:{default_port}\" and TOKEN in /etc/next-update-server/config, then run: sudo systemctl restart next-update-server."
    else:
        result["summary"] = f"No response from {target} (ping timed out, probe ports closed)."
        result["advice"] = "Check that the IP is correct, the server is powered on, and firewall allows connections."

    return result


class Handler(BaseHTTPRequestHandler):
    server_version = "next-update"

    def log_message(self, *args):
        pass

    def send(self, code, body, ctype="text/plain; charset=utf-8", headers=None):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        for k, v in (headers or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def body(self):
        n = int(self.headers.get("Content-Length") or 0)
        if n < 0 or n > MAX_BODY:
            raise ValueError("body too large")
        return self.rfile.read(n)

    def get_session_token(self):
        cookie_header = self.headers.get("Cookie", "")
        for part in cookie_header.split(";"):
            k, _, v = part.strip().partition("=")
            if k == "session":
                return v.strip()
        return ""

    def admin(self, is_api=False):
        # 1. Check session cookie
        sess = self.get_session_token()
        if sess:
            with conn() as c:
                row = c.execute("SELECT user, created_at FROM sessions WHERE token=?", (sess,)).fetchone()
                if row:
                    if time.time() - row["created_at"] < 30 * 86400:
                        return True
                    else:
                        c.execute("DELETE FROM sessions WHERE token=?", (sess,))

        # 2. Check HTTP Basic Auth (for curl or legacy scripts)
        h = self.headers.get("Authorization", "")
        if h.startswith("Basic "):
            try:
                given = base64.b64decode(h[6:]).decode()
            except Exception:
                given = ""
            user, _, password = given.partition(":")
            user_ok = hmac.compare_digest(user.encode(), ADMIN_USER.encode())
            pass_ok = hmac.compare_digest(password.encode(), ADMIN_PASSWORD.encode())
            if user_ok and pass_ok:
                return True

        # Unauthenticated response
        if is_api:
            self.send(401, json.dumps({"error": "login required"}), "application/json")
        else:
            self.send(200, LOGIN_PAGE, "text/html; charset=utf-8", {
                "Content-Security-Policy":
                    "default-src 'none'; script-src 'unsafe-inline'; "
                    "style-src 'unsafe-inline'; connect-src 'self'; img-src 'self' data:"
            })
        return False

    def agent(self):
        h = self.headers.get("Authorization", "")
        token_given = h[7:].strip().strip("'\"") if h.startswith("Bearer ") else ""
        client_ip = self.client_address[0]
        if h.startswith("Bearer ") and hmac.compare_digest(token_given.encode(), TOKEN.encode()):
            return True
        reason = "missing Bearer prefix" if not h.startswith("Bearer ") else "token mismatch"
        record_rejection(client_ip, "bad token", reason)
        print("rejected request from a server at %s (%s)" % (client_ip, reason), flush=True)
        self.send(401, "bad token\n")
        return False

    def do_GET(self):
        u = urlparse(self.path)
        if u.path == "/login":
            return self.send(200, LOGIN_PAGE, "text/html; charset=utf-8")

        if u.path == "/logout":
            sess = self.get_session_token()
            if sess:
                with conn() as c:
                    c.execute("DELETE FROM sessions WHERE token=?", (sess,))
            return self.send(302, "", headers={"Location": "/", "Set-Cookie": "session=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0"})

        if u.path not in ("/", "/api/state", "/api/log"):
            return self.send(404, "not found\n")

        is_api = u.path.startswith("/api/")
        if not self.admin(is_api=is_api):
            return

        if u.path == "/":
            return self.send(200, PAGE, "text/html; charset=utf-8", {
                "Content-Security-Policy":
                    "default-src 'none'; script-src 'unsafe-inline'; "
                    "style-src 'unsafe-inline'; connect-src 'self'; img-src 'self' data:"})
        if u.path == "/api/state":
            return self.send(200, json.dumps(state()), "application/json")
        host = (parse_qs(u.query).get("host") or [""])[0]
        with conn() as c:
            row = c.execute("SELECT last_log FROM hosts WHERE name=?", (host,)).fetchone()
        self.send(200, (row[0] or "") if row else "")

    def do_POST(self):
        u = urlparse(self.path)
        try:
            # Login endpoint (no admin check)
            if u.path == "/api/login":
                if not self.headers.get("Content-Type", "").startswith("application/json"):
                    return self.send(415, "json required\n")
                req = json.loads(self.body() or b"{}")
                user = (req.get("user") or "").strip()
                password = req.get("password") or ""
                user_ok = hmac.compare_digest(user.encode(), ADMIN_USER.encode())
                pass_ok = hmac.compare_digest(password.encode(), ADMIN_PASSWORD.encode())
                if user_ok and pass_ok:
                    token = secrets.token_hex(32)
                    with conn() as c:
                        c.execute("INSERT INTO sessions(token, created_at, user) VALUES(?, ?, ?)",
                                  (token, time.time(), user))
                    return self.send(200, json.dumps({"ok": True}), "application/json", headers={
                        "Set-Cookie": f"session={token}; Path=/; HttpOnly; SameSite=Lax; Max-Age=2592000"
                    })
                return self.send(401, json.dumps({"error": "Invalid username or password"}), "application/json")

            if u.path == "/api/logout":
                sess = self.get_session_token()
                if sess:
                    with conn() as c:
                        c.execute("DELETE FROM sessions WHERE token=?", (sess,))
                return self.send(200, json.dumps({"ok": True}), "application/json", headers={
                    "Set-Cookie": "session=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0"
                })

            # Agent check-in endpoints
            if u.path in ("/api/poll", "/api/log"):
                if not self.agent():
                    return
                host = (parse_qs(u.query).get("host") or [""])[0]
                client_ip = self.client_address[0]
                if not HOST_RE.match(host):
                    record_rejection(client_ip, "bad host", f"invalid host name '{host}'")
                    return self.send(400, "bad host\n")
                data = self.body().decode("utf-8", "replace")
                if u.path == "/api/poll":
                    status = "running" if self.headers.get("X-Status") == "running" else "idle"
                    return self.send(200, agent_poll(host, status, data, client_ip))
                result = "ok" if self.headers.get("X-Result") == "ok" else "failed"
                agent_log(host, result, data[-65536:])
                return self.send(200, "ok\n")

            # Admin management endpoints
            if u.path not in ("/api/hold", "/api/run", "/api/delete", "/api/check"):
                return self.send(404, "not found\n")
            if not self.admin(is_api=True):
                return
            if not self.headers.get("Content-Type", "").startswith("application/json"):
                return self.send(415, "json required\n")

            req = json.loads(self.body() or b"{}")

            if u.path == "/api/check":
                target = req.get("target", "")
                if not isinstance(target, str) or len(target) > 128:
                    return self.send(400, "bad target\n")
                return self.send(200, json.dumps(check_target(target, PORT)), "application/json")

            host = req.get("host", "")
            if not isinstance(host, str) or not (host == "" and u.path == "/api/hold" or HOST_RE.match(host)):
                return self.send(400, "bad host\n")
            with conn() as c:
                if u.path == "/api/hold":
                    pkg = req.get("pkg", "")
                    if not isinstance(pkg, str) or not PKG_RE.match(pkg):
                        return self.send(400, "bad package name\n")
                    on = bool(req.get("on"))
                    if on:
                        c.execute("INSERT OR IGNORE INTO holds(host,pkg) VALUES(?,?)", (host, pkg))
                    else:
                        c.execute("DELETE FROM holds WHERE host=? AND pkg=?", (host, pkg))
                    print("hold %s %s for %s" % (pkg, "on" if on else "off", host or "all hosts"), flush=True)
                elif u.path == "/api/run":
                    items = req.get("items") or []
                    if not isinstance(items, list) or len(items) > 500 or not all(valid_item(i) for i in items):
                        return self.send(400, "bad items\n")
                    text = "\n".join("%s %s" % (i["kind"], i["name"]) for i in items)
                    c.execute("UPDATE hosts SET run_requested=1, run_items=? WHERE name=? AND status != 'running'",
                              (text or None, host))
                    print("update requested for %s (%s)" % (host, "%d selected items" % len(items) if items else "all"),
                          flush=True)
                else:
                    c.execute("DELETE FROM hosts WHERE name=?", (host,))
                    c.execute("DELETE FROM holds WHERE host=?", (host,))
                    print("removed host %s" % host, flush=True)
            self.send(200, "ok\n")
        except (ValueError, KeyError, TypeError, AttributeError) as e:
            self.send(400, "bad request: %s\n" % e)


