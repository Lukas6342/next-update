[Unit]
Description=next-update-web central web UI
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=next-update-web
EnvironmentFile=/etc/next-update-web/config
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/next-update-web
Restart=on-failure
RestartSec=5
SyslogIdentifier=next-update-web
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
