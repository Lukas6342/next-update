#!/usr/bin/env python3
"""next-update-server - central web UI for next-update agents (stdlib only)."""
import base64
import hmac
import json
import os
import re
import sqlite3
import sys
import time
from contextlib import contextmanager
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

LISTEN = os.environ.get("LISTEN", "0.0.0.0")
PORT = int(os.environ.get("PORT", "8080"))
ADMIN_PASSWORD = os.environ.get("ADMIN_PASSWORD", "")
AGENT_TOKEN = os.environ.get("AGENT_TOKEN", "")
DB_FILE = os.path.join(os.environ.get("STATE_DIRECTORY", "."), "state.db")
MAX_BODY = 1 << 20
HOST_RE = re.compile(r"^[A-Za-z0-9._-]{1,64}$")
PKG_RE = re.compile(r"^[A-Za-z0-9@._+-]{1,128}$")


@contextmanager
def conn():
    c = sqlite3.connect(DB_FILE, timeout=10)
    c.row_factory = sqlite3.Row
    try:
        with c:
            yield c
    finally:
        c.close()


def init_db():
    with conn() as c:
        c.executescript(
            """
            CREATE TABLE IF NOT EXISTS hosts(
                name TEXT PRIMARY KEY, last_seen REAL, status TEXT, pending TEXT,
                run_requested INTEGER NOT NULL DEFAULT 0,
                last_run REAL, last_result TEXT, last_log TEXT);
            CREATE TABLE IF NOT EXISTS holds(
                host TEXT NOT NULL, pkg TEXT NOT NULL, PRIMARY KEY(host, pkg));
            """
        )


def state():
    now = time.time()
    with conn() as c:
        hosts = [dict(r) for r in c.execute(
            "SELECT name,last_seen,status,pending,run_requested,last_run,last_result,"
            "last_log IS NOT NULL AND last_log != '' AS has_log FROM hosts ORDER BY name")]
        holds = {}
        for r in c.execute("SELECT host,pkg FROM holds ORDER BY pkg"):
            holds.setdefault(r["host"], []).append(r["pkg"])
    for h in hosts:
        h["pending"] = [l for l in (h["pending"] or "").splitlines() if l.strip()]
        h["holds"] = holds.get(h["name"], [])
    return {"now": now, "global": holds.get("", []), "hosts": hosts}


def agent_poll(host, status, pending):
    with conn() as c:
        c.execute(
            "INSERT INTO hosts(name,last_seen,status,pending) VALUES(?,?,?,?) "
            "ON CONFLICT(name) DO UPDATE SET last_seen=excluded.last_seen,"
            "status=excluded.status,pending=excluded.pending",
            (host, time.time(), status, pending[:262144]))
        run = c.execute("SELECT run_requested FROM hosts WHERE name=?", (host,)).fetchone()[0]
        if run:
            c.execute("UPDATE hosts SET run_requested=0 WHERE name=?", (host,))
        pkgs = [r[0] for r in c.execute(
            "SELECT DISTINCT pkg FROM holds WHERE host IN ('', ?) ORDER BY pkg", (host,))]
    return "".join("hold %s\n" % p for p in pkgs) + ("run\n" if run else "")


def agent_log(host, result, text):
    with conn() as c:
        c.execute("UPDATE hosts SET last_run=?, last_result=?, last_log=? WHERE name=?",
                  (time.time(), result, text, host))


class Handler(BaseHTTPRequestHandler):
    server_version = "next-update"

    def log_message(self, *args):
        pass

    def send(self, code, body, ctype="text/plain; charset=utf-8", headers=None):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        for k, v in (headers or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def body(self):
        n = int(self.headers.get("Content-Length") or 0)
        if n < 0 or n > MAX_BODY:
            raise ValueError("body too large")
        return self.rfile.read(n)

    def admin(self):
        h = self.headers.get("Authorization", "")
        if h.startswith("Basic "):
            try:
                given = base64.b64decode(h[6:]).decode()
            except Exception:
                given = ""
            if hmac.compare_digest(given.partition(":")[2].encode(), ADMIN_PASSWORD.encode()):
                return True
        self.send(401, "login required\n", headers={"WWW-Authenticate": 'Basic realm="next-update"'})
        return False

    def agent(self):
        h = self.headers.get("Authorization", "")
        if h.startswith("Bearer ") and hmac.compare_digest(h[7:].encode(), AGENT_TOKEN.encode()):
            return True
        print("rejected agent request from %s (bad token)" % self.client_address[0], flush=True)
        self.send(401, "bad token\n")
        return False

    def do_GET(self):
        u = urlparse(self.path)
        if u.path not in ("/", "/api/state", "/api/log"):
            return self.send(404, "not found\n")
        if not self.admin():
            return
        if u.path == "/":
            return self.send(200, PAGE, "text/html; charset=utf-8", {
                "Content-Security-Policy":
                    "default-src 'none'; script-src 'unsafe-inline'; "
                    "style-src 'unsafe-inline'; connect-src 'self'"})
        if u.path == "/api/state":
            return self.send(200, json.dumps(state()), "application/json")
        host = (parse_qs(u.query).get("host") or [""])[0]
        with conn() as c:
            row = c.execute("SELECT last_log FROM hosts WHERE name=?", (host,)).fetchone()
        self.send(200, (row[0] or "") if row else "")

    def do_POST(self):
        u = urlparse(self.path)
        try:
            if u.path in ("/api/poll", "/api/log"):
                if not self.agent():
                    return
                host = (parse_qs(u.query).get("host") or [""])[0]
                if not HOST_RE.match(host):
                    return self.send(400, "bad host\n")
                data = self.body().decode("utf-8", "replace")
                if u.path == "/api/poll":
                    status = "running" if self.headers.get("X-Status") == "running" else "idle"
                    return self.send(200, agent_poll(host, status, data))
                result = "ok" if self.headers.get("X-Result") == "ok" else "failed"
                agent_log(host, result, data[-65536:])
                return self.send(200, "ok\n")

            if u.path not in ("/api/hold", "/api/run", "/api/delete"):
                return self.send(404, "not found\n")
            if not self.admin():
                return
            if not self.headers.get("Content-Type", "").startswith("application/json"):
                return self.send(415, "json required\n")
            req = json.loads(self.body() or b"{}")
            host = req.get("host", "")
            if not isinstance(host, str) or not (host == "" and u.path == "/api/hold" or HOST_RE.match(host)):
                return self.send(400, "bad host\n")
            with conn() as c:
                if u.path == "/api/hold":
                    pkg = req.get("pkg", "")
                    if not isinstance(pkg, str) or not PKG_RE.match(pkg):
                        return self.send(400, "bad package name\n")
                    on = bool(req.get("on"))
                    if on:
                        c.execute("INSERT OR IGNORE INTO holds(host,pkg) VALUES(?,?)", (host, pkg))
                    else:
                        c.execute("DELETE FROM holds WHERE host=? AND pkg=?", (host, pkg))
                    print("hold %s %s for %s" % (pkg, "on" if on else "off", host or "all hosts"), flush=True)
                elif u.path == "/api/run":
                    c.execute("UPDATE hosts SET run_requested=1 WHERE name=? AND status != 'running'", (host,))
                    print("manual update requested for %s" % host, flush=True)
                else:
                    c.execute("DELETE FROM hosts WHERE name=?", (host,))
                    c.execute("DELETE FROM holds WHERE host=?", (host,))
                    print("removed host %s" % host, flush=True)
            self.send(200, "ok\n")
        except (ValueError, KeyError, TypeError, AttributeError) as e:
            self.send(400, "bad request: %s\n" % e)


PAGE = r"""<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>next-update</title>
<style>
