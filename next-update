#!/usr/bin/env bash
# next-update - auto update daemon for servers (systemd)
# Logs go to stdout/stderr -> journalctl -u next-update
# Optional: reports to / takes "update now" and package holds from next-update-server.
# The server can never run arbitrary commands, only the ones in the local config.

set -u
export LC_ALL=C
CONFIG="${NEXT_UPDATE_CONFIG:-/etc/next-update/config}"

log() { echo "$*"; }
err() { echo "<3>$*"; }   # journald priority "err"

load_config() {
    RUN_ON_BOOT=yes
    UPDATE_TIME=""
    UPDATE_DAYS="all"
    STOP_ON_ERROR=no
    HOLD_PKGS=()
    COMMANDS=()
    SERVER_URL=""
    SERVER_TOKEN=""
    HOST_NAME="$HOSTNAME"
    POLL_INTERVAL=10
    CHECK_INTERVAL=900
    [[ -r $CONFIG ]] || { err "config not readable: $CONFIG"; return 1; }
    # shellcheck source=/dev/null
    source "$CONFIG" || { err "config has errors: $CONFIG"; return 1; }
    ((${#COMMANDS[@]})) || { err "COMMANDS is empty in $CONFIG"; return 1; }
    [[ $POLL_INTERVAL =~ ^[0-9]+$ ]] && ((POLL_INTERVAL >= 2)) || POLL_INTERVAL=10
    [[ $CHECK_INTERVAL =~ ^[0-9]+$ ]] && ((CHECK_INTERVAL >= 60)) || CHECK_INTERVAL=900
    SERVER_URL=${SERVER_URL%/}
}

run_updates() {
    local c rc failed=0
    log "update run started"
    for c in "${COMMANDS[@]}"; do
        log "running: $c"
        bash -c "$c" </dev/null
        rc=$?
        if ((rc)); then
            err "failed (exit $rc): $c"
            failed=1
            [[ $STOP_ON_ERROR == yes ]] && break
        else
            log "ok: $c"
        fi
    done
    if ((failed)); then err "update run finished with errors"; else log "update run finished"; fi
    return $failed
}

# epoch of the next matching day/time in the future
next_epoch() {
    local d t now day days
    now=$(date +%s)
    days=",${UPDATE_DAYS// /},"
    days=${days,,}
    for d in 0 1 2 3 4 5 6 7; do
        # build "YYYY-MM-DD HH:MM" explicitly (a bare "+N day" after a time is parsed as a timezone)
        t=$(date -d "$(date -d "$d days" +%F) $UPDATE_TIME" +%s 2>/dev/null) || return 1
        ((t > now)) || continue
        day=$(date -d "@$t" +%a)
        day=${day,,}
        if [[ $days == ",all," || $days == *",$day,"* ]]; then
            echo "$t"
            return 0
        fi
    done
    return 1
}

PENDING_FILE=$(mktemp)
LOG_FILE=$(mktemp)
trap 'rm -f "$PENDING_FILE" "$LOG_FILE"' EXIT
STATUS=idle
SRV_HOLD=()
SRV_RUN=0
SRV_OK=1
last_check=0

# list of pending updates (needs pacman-contrib for checkupdates, which does not touch the real db)
refresh_pending() {
    local tmp rc
    last_check=$(date +%s)
    tmp=$(mktemp)
    if command -v checkupdates >/dev/null; then
        checkupdates >"$tmp" 2>/dev/null; rc=$?
        ((rc == 0 || rc == 2)) && cp "$tmp" "$PENDING_FILE"   # 2 = nothing pending
    elif command -v pacman >/dev/null; then
        pacman -Qu >"$tmp" 2>/dev/null; rc=$?
        ((rc == 0 || rc == 1)) && cp "$tmp" "$PENDING_FILE"
    fi
    rm -f "$tmp"
}

# tell the server we are alive + pending list, fetch holds and "run" requests
poll_server() {
    local resp k v
    resp=$(curl -fsS --max-time 10 -X POST \
        -H "Authorization: Bearer $SERVER_TOKEN" -H "X-Status: $STATUS" \
        --data-binary @"$PENDING_FILE" \
        "$SERVER_URL/api/poll?host=$HOST_NAME" 2>&1) || {
        if ((SRV_OK)); then err "server: ${resp:-request failed}"; SRV_OK=0; fi
        return 1
    }
    if ((!SRV_OK)); then log "server reachable again"; SRV_OK=1; fi
    SRV_HOLD=()
    while read -r k v; do
        case $k in
            hold) [[ $v =~ ^[A-Za-z0-9@._+-]+$ ]] && SRV_HOLD+=("$v") ;;
            run) SRV_RUN=1 ;;
        esac
    done <<<"$resp"
    return 0
}

send_log() {
    tail -c 65536 "$LOG_FILE" | sed 's/^<[0-7]>//' | curl -fsS --max-time 20 -X POST \
        -H "Authorization: Bearer $SERVER_TOKEN" -H "X-Result: $1" \
        --data-binary @- "$SERVER_URL/api/log?host=$HOST_NAME" >/dev/null 2>&1 \
        || err "could not send log to server"
}

do_run() {
    local rc
    if [[ -n $SERVER_URL ]]; then
        STATUS=running
        poll_server   # announce "running", get current holds
        SRV_RUN=0     # a request that arrives now is covered by this run
    fi
    local all=("${HOLD_PKGS[@]}" "${SRV_HOLD[@]}")
    export NU_IGNORE
    NU_IGNORE=$(IFS=,; echo "${all[*]}")
    [[ -n $NU_IGNORE ]] && log "held packages: $NU_IGNORE"

    run_updates 2>&1 | tee "$LOG_FILE"
    rc=${PIPESTATUS[0]}

    STATUS=idle
    if [[ -n $SERVER_URL ]]; then
        refresh_pending
        send_log "$( ((rc)) && echo failed || echo ok )"
        poll_server
    fi
}

load_config || exit 1

if [[ -n $SERVER_URL ]]; then
    log "server: $SERVER_URL as $HOST_NAME"
    refresh_pending
    poll_server
fi
[[ $RUN_ON_BOOT == yes ]] && do_run

target=0
sig=""
while true; do
    load_config || { sleep 60; continue; }

    if [[ -n $SERVER_URL ]]; then
        poll_server
        if ((SRV_RUN)); then
            SRV_RUN=0
            log "update requested via server"
            do_run
            continue
        fi
        (($(date +%s) - last_check >= CHECK_INTERVAL)) && refresh_pending
    fi

    if [[ -n $UPDATE_TIME ]]; then
        if [[ $sig != "$UPDATE_TIME|$UPDATE_DAYS" ]]; then
            sig="$UPDATE_TIME|$UPDATE_DAYS"
            target=0
        fi
        if ((target == 0)); then
            target=$(next_epoch) || { target=0; err "invalid UPDATE_TIME/UPDATE_DAYS in $CONFIG"; sleep 60; continue; }
            log "next run: $(date -d "@$target" '+%a %F %T')"
        fi
        if (($(date +%s) >= target)); then
            target=0
            do_run
            continue
        fi
    else
        sig=""
        target=0
    fi

    sleep "$POLL_INTERVAL"
done
