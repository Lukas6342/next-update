#!/usr/bin/env bash
# next-update-server - auto update daemon for servers (systemd)
# Logs go to stdout/stderr -> journalctl -u next-update-server
# Optional: reports to / takes "update all", selected updates and package holds from next-update-web.
# The web ui can never run arbitrary commands: it only sends "run COMMANDS" or a selection of items,
# and the daemon only updates items that are in its own current pending list.

set -u
export LC_ALL=C
CONFIG="${NEXT_UPDATE_CONFIG:-/etc/next-update-server/config}"

log() { echo "$*"; }
err() { echo "<3>$*"; }   # journald priority "err"

load_config() {
    RUN_ON_BOOT=no
    UPDATE_TIME=""
    UPDATE_DAYS="all"
    STOP_ON_ERROR=no
    HOLD_PKGS=()
    COMMANDS=()
    WEB_URL=""
    TOKEN=""
    HOST_NAME=""
    POLL_INTERVAL=10
    CHECK_INTERVAL=900
    AUR_USER=""
    DOCKER_CHECK=yes
    DOCKER_CHECK_INTERVAL=21600
    DEBIAN_MODE=no
    [[ -r $CONFIG ]] || { err "config not readable: $CONFIG"; return 1; }
    # shellcheck source=/dev/null
    source "$CONFIG" || { err "config has errors: $CONFIG"; return 1; }
    [[ $DEBIAN_MODE == yes ]] || DEBIAN_MODE=no
    if ((${#COMMANDS[@]} == 0)); then   # built-in defaults
        if [[ $DEBIAN_MODE == yes ]]; then
            COMMANDS=('apt-get update'
                'apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold upgrade')
        else
            COMMANDS=('pacman -Syu --noconfirm ${NU_IGNORE:+--ignore "$NU_IGNORE"}')
        fi
    fi
    [[ $DEBIAN_MODE == yes ]] && export DEBIAN_FRONTEND=noninteractive
    [[ $POLL_INTERVAL =~ ^[0-9]+$ ]] && ((POLL_INTERVAL >= 2)) || POLL_INTERVAL=10
    [[ $CHECK_INTERVAL =~ ^[0-9]+$ ]] && ((CHECK_INTERVAL >= 60)) || CHECK_INTERVAL=900
    [[ $DOCKER_CHECK_INTERVAL =~ ^[0-9]+$ ]] && ((DOCKER_CHECK_INTERVAL >= 600)) || DOCKER_CHECK_INTERVAL=21600

    # Clean and normalize WEB_URL
    WEB_URL=$(echo "${WEB_URL:-}" | sed -e 's/^[[:space:]"'\''"]*//' -e 's/[[:space:]"'\''"]*$//' -e 's#/*$##')
    if [[ -n $WEB_URL ]]; then
        [[ $WEB_URL != http://* && $WEB_URL != https://* ]] && WEB_URL="http://$WEB_URL"
        # 0.0.0.0 is not a valid destination address for a client
        WEB_URL="${WEB_URL//0.0.0.0/127.0.0.1}"
    fi

    # Clean TOKEN
    TOKEN=$(echo "${TOKEN:-}" | sed -e 's/^[[:space:]"'\''"]*//' -e 's/[[:space:]"'\''"]*$//')

    # Determine and sanitize HOST_NAME
    local def_host
    def_host=$(uname -n 2>/dev/null || hostname 2>/dev/null || echo "server")
    def_host=${def_host%%.*}
    if [[ -z ${HOST_NAME:-} || $HOST_NAME == *'$'* ]]; then
        HOST_NAME="$def_host"
    fi
    HOST_NAME=$(echo "$HOST_NAME" | tr -cd 'A-Za-z0-9._-')
    HOST_NAME="${HOST_NAME:0:64}"
    [[ -z $HOST_NAME ]] && HOST_NAME="server"
    return 0
}

# ---------------------------------------------------------------- full run (COMMANDS from config)

# apt has no --ignore: held packages are put on "apt-mark hold" for the duration of a full run
APT_HELD_BY_US=()
apt_hold_start() {
    local p already
    local -a names=()
    APT_HELD_BY_US=()
    [[ -n ${NU_IGNORE:-} ]] || return 0
    IFS=, read -ra names <<<"$NU_IGNORE"
    already=$(apt-mark showhold 2>/dev/null)
    for p in "${names[@]}"; do
        grep -qxF "$p" <<<"$already" && continue
        dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q 'install ok installed' || continue
        apt-mark hold "$p" >/dev/null 2>&1 && APT_HELD_BY_US+=("$p")
    done
    ((${#APT_HELD_BY_US[@]})) && log "apt: holding ${APT_HELD_BY_US[*]} during this run"
    return 0
}
apt_hold_end() {
    ((${#APT_HELD_BY_US[@]})) && apt-mark unhold "${APT_HELD_BY_US[@]}" >/dev/null 2>&1
    APT_HELD_BY_US=()
    return 0
}

run_updates() {
    local c rc failed=0
    log "update run started"
    if [[ $DEBIAN_MODE != yes && -f /var/lib/pacman/db.lck ]]; then
        if pgrep -x pacman >/dev/null 2>&1; then
            err "pacman is currently locked by another running process (/var/lib/pacman/db.lck)"
        else
            err "stale pacman lock file found at /var/lib/pacman/db.lck"
        fi
    fi
    [[ $DEBIAN_MODE == yes ]] && apt_hold_start
    for c in "${COMMANDS[@]}"; do
        log "running: $c"
        bash -c "$c" </dev/null
        rc=$?
        if ((rc)); then
            err "failed (exit $rc): $c"
            failed=1
            [[ $STOP_ON_ERROR == yes ]] && break
        else
            log "ok: $c"
        fi
    done
    [[ $DEBIAN_MODE == yes ]] && apt_hold_end
    if ((failed)); then err "update run finished with errors"; else log "update run finished"; fi
    return $failed
}

# ---------------------------------------------------------------- schedule

# epoch of the next matching day/time in the future
next_epoch() {
    local d t now day days
    now=$(date +%s)
    days=",${UPDATE_DAYS// /},"
    days=${days,,}
    for d in 0 1 2 3 4 5 6 7; do
        # build "YYYY-MM-DD HH:MM" explicitly (a bare "+N day" after a time is parsed as a timezone)
        t=$(date -d "$(date -d "$d days" +%F) $UPDATE_TIME" +%s 2>/dev/null) || return 1
        ((t > now)) || continue
        day=$(date -d "@$t" +%a)
        day=${day,,}
        if [[ $days == ",all," || $days == *",$day,"* ]]; then
            echo "$t"
            return 0
        fi
    done
    return 1
}

# ---------------------------------------------------------------- pending updates
# Files hold lines "kind<TAB>name<TAB>detail", kind = pacman | apt | aur | docker

PEND_DIR=$(mktemp -d)
PEND_PACMAN=$PEND_DIR/pacman
PEND_AUR=$PEND_DIR/aur
PEND_APT=$PEND_DIR/apt
PEND_DOCKER=$PEND_DIR/docker
LOG_FILE=$PEND_DIR/log
: >"$PEND_PACMAN"; : >"$PEND_AUR"; : >"$PEND_APT"; : >"$PEND_DOCKER"
trap 'rm -rf "$PEND_DIR"' EXIT

STATUS=idle
SRV_HOLD=()
SRV_ITEMS=()
SRV_RUN=0       # 0 = nothing, 1 = run COMMANDS, 2 = update selected items
SRV_OK=1
SEL=()
last_check=0
last_docker_check=0

# "pkg old -> new" -> "kind<TAB>pkg<TAB>old -> new"
fmt_pkgs() { awk -v k="$1" 'NF >= 4 {printf "%s\t%s\t%s -> %s\n", k, $1, $2, $4}'; }

# repo packages (checkupdates from pacman-contrib works on a temporary db copy)
refresh_pacman() {
    local tmp rc
    tmp=$(mktemp -p "$PEND_DIR")
    if command -v checkupdates >/dev/null; then
        checkupdates 2>/dev/null | fmt_pkgs pacman >"$tmp"; rc=${PIPESTATUS[0]}
        ((rc == 0 || rc == 2)) && mv "$tmp" "$PEND_PACMAN"    # 2 = nothing pending
    elif command -v pacman >/dev/null; then
        pacman -Qu 2>/dev/null | fmt_pkgs pacman >"$tmp"; rc=${PIPESTATUS[0]}
        ((rc == 0 || rc == 1)) && mv "$tmp" "$PEND_PACMAN"
    fi
    rm -f "$tmp"
}

# yay/makepkg refuse to run as root, so AUR work runs as AUR_USER
as_aur() { runuser -u "$AUR_USER" -- env "HOME=$(getent passwd "$AUR_USER" | cut -d: -f6)" "$@"; }

refresh_aur() {
    local tmp rc
    [[ -n $AUR_USER ]] && command -v yay >/dev/null || { : >"$PEND_AUR"; return; }
    tmp=$(mktemp -p "$PEND_DIR")
    as_aur yay -Qua 2>/dev/null | fmt_pkgs aur >"$tmp"; rc=${PIPESTATUS[0]}
    ((rc == 0 || rc == 1)) && mv "$tmp" "$PEND_AUR"
    rm -f "$tmp"
}

# Debian: refresh the package lists, then simulate "apt-get upgrade" (what the default command does)
refresh_apt() {
    local tmp rc
    command -v apt-get >/dev/null || { : >"$PEND_APT"; return; }
    apt-get -qq update >/dev/null 2>&1   # on failure (lock, offline) the old lists are used
    tmp=$(mktemp -p "$PEND_DIR")
    apt-get -s upgrade 2>/dev/null | awk '$1 == "Inst" {
        old = ""; new = $3
        if ($3 ~ /^\[/) { old = $3; new = $4; gsub(/[\[\]]/, "", old) }
        gsub(/^\(/, "", new)
        printf "apt\t%s\t%s -> %s\n", $2, old, new }' >"$tmp"
    rc=${PIPESTATUS[0]}
    ((rc == 0)) && mv "$tmp" "$PEND_APT"
    rm -f "$tmp"
}

# names of containers (all states) created from exactly this image reference
docker_containers_of() {
    docker ps -a --format '{{.Names}} {{.Image}}' 2>/dev/null | awk -v i="$1" '$2 == i {print $1}'
}

# images of existing containers whose registry digest differs from the local one
refresh_docker() {
    local tmp img imgs remote names
    last_docker_check=$(date +%s)
    [[ $DOCKER_CHECK == yes ]] && command -v docker >/dev/null || { : >"$PEND_DOCKER"; return; }
    docker info >/dev/null 2>&1 || return    # daemon down: keep the old list
    tmp=$(mktemp -p "$PEND_DIR")
    imgs=$(docker ps -a --format '{{.Image}}' 2>/dev/null | sort -u)
    while read -r img; do
        [[ $img =~ ^[A-Za-z0-9][A-Za-z0-9._/:-]*$ ]] || continue   # skips digest-pinned (@sha256) refs
        [[ $img =~ ^[0-9a-f]{12,64}$ ]] && continue                 # bare image ids
        remote=$(docker buildx imagetools inspect "$img" --format '{{.Manifest.Digest}}' 2>/dev/null) || continue
        [[ $remote == sha256:* ]] || continue
        docker image inspect "$img" --format '{{range .RepoDigests}}{{println .}}{{end}}' 2>/dev/null \
            | grep -q "@${remote}\$" && continue
        names=$(docker_containers_of "$img" | paste -sd, -)
        printf 'docker\t%s\tused by: %s\n' "$img" "$names" >>"$tmp"
    done <<<"$imgs"
    mv "$tmp" "$PEND_DOCKER"
}

refresh_fast() {
    if [[ $DEBIAN_MODE == yes ]]; then
        : >"$PEND_PACMAN"; : >"$PEND_AUR"
        refresh_apt
    else
        : >"$PEND_APT"
        refresh_pacman; refresh_aur
    fi
    last_check=$(date +%s)
}
refresh_all() { refresh_fast; refresh_docker; }

in_pending() {   # $1 kind, $2 name
    awk -F'\t' -v k="$1" -v n="$2" '$1 == k && $2 == n {f = 1} END {exit !f}' \
        "$PEND_PACMAN" "$PEND_APT" "$PEND_AUR" "$PEND_DOCKER"
}

# ---------------------------------------------------------------- selected updates

# pull the image, then recreate compose-managed containers that use it
update_docker() {
    local img=$1 c proj svc dir cfg f key rc=0 seen=""
    local -a args files
    log "docker: pulling $img"
    docker pull "$img" </dev/null || return 1
    while read -r c; do
        proj=$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project"}}' "$c")
        svc=$(docker inspect -f '{{index .Config.Labels "com.docker.compose.service"}}' "$c")
        dir=$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' "$c")
        cfg=$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project.config_files"}}' "$c")
        if [[ -z $proj || -z $svc ]]; then
            log "docker: container $c is not managed by compose - recreate it yourself to use the new image"
            continue
        fi
        key="$proj/$svc"
        [[ $seen == *"|$key|"* ]] && continue
        seen+="|$key|"
        args=(); files=()
        IFS=, read -ra files <<<"$cfg"
        for f in "${files[@]}"; do args+=(-f "$f"); done
        log "docker: recreating $key"
        docker compose --project-directory "$dir" -p "$proj" "${args[@]}" up -d --no-deps "$svc" </dev/null || rc=1
    done < <(docker_containers_of "$img")
    return $rc
}

# update only the items in SEL ("kind name"), each must be in our own pending list
run_selected() {
    local it kind name failed=0
    local -a pm=() ap=() ar=() dk=()
    for it in "${SEL[@]}"; do
        kind=${it%% *}
        name=${it#* }
        if ! in_pending "$kind" "$name"; then
            err "skipping $kind $name: not in this server's pending list"
            continue
        fi
        case $kind in
            pacman) pm+=("$name") ;;
            apt) ap+=("$name") ;;
            aur) ar+=("$name") ;;
            docker) dk+=("$name") ;;
        esac
    done
    log "selective update run started"
    if ((${#pm[@]})); then
        log "pacman: ${pm[*]}"
        pacman -Sy --noconfirm -- "${pm[@]}" </dev/null || { err "pacman failed"; failed=1; }
    fi
    if ((${#ap[@]})); then
        log "apt: ${ap[*]}"
        apt-get install -y --only-upgrade -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
            "${ap[@]}" </dev/null || { err "apt failed"; failed=1; }
    fi
    if ((${#ar[@]})); then
        log "aur: ${ar[*]}"
        as_aur yay -S --noconfirm --answerdiff None --answerclean None --answeredit None -- "${ar[@]}" </dev/null \
            || { err "yay failed"; failed=1; }
    fi
    for name in "${dk[@]}"; do
        update_docker "$name" || { err "docker update failed: $name"; failed=1; }
    done
    if ((failed)); then err "selective update run finished with errors"; else log "selective update run finished"; fi
    return $failed
}

# ---------------------------------------------------------------- server link

# tell the web ui we are alive + pending list, fetch holds and run requests
poll_server() {
    local http_code curl_rc body
    SRV_RUN=0
    SRV_ITEMS=()
    [[ -z $WEB_URL ]] && return 0
    if [[ -z $TOKEN ]]; then
        if ((SRV_OK)); then
            err "web ui ($WEB_URL): TOKEN is not set in $CONFIG"
            SRV_OK=0
        fi
        return 1
    fi

    local tmp_resp
    tmp_resp=$(mktemp -p "$PEND_DIR")
    http_code=$(cat "$PEND_PACMAN" "$PEND_APT" "$PEND_AUR" "$PEND_DOCKER" | curl -sS --max-time 10 \
        -w "%{http_code}" -o "$tmp_resp" -X POST \
        -H "Authorization: Bearer $TOKEN" -H "X-Status: $STATUS" \
        --data-binary @- "$WEB_URL/api/poll?host=$HOST_NAME" 2>&1)
    curl_rc=$?

    if ((curl_rc != 0)); then
        if ((SRV_OK)); then
            case $curl_rc in
                7)  err "web ui: connection refused at $WEB_URL - is next-update-web running?" ;;
                28) err "web ui: connection timed out to $WEB_URL - check IP, port and firewall" ;;
                *)  err "web ui: connection failed to $WEB_URL (curl exit $curl_rc: $http_code)" ;;
            esac
            SRV_OK=0
        fi
        rm -f "$tmp_resp"
        return 1
    fi

    if [[ $http_code != 200 ]]; then
        body=$(head -n 2 "$tmp_resp" 2>/dev/null | tr -d '\r\n')
        rm -f "$tmp_resp"
        if ((SRV_OK)); then
            if [[ $http_code == 401 ]]; then
                err "web ui: authentication failed (HTTP 401: bad token) at $WEB_URL - check that TOKEN in $CONFIG matches web UI"
            elif [[ $http_code == 400 ]]; then
                err "web ui: request rejected (HTTP 400: ${body:-bad request}) - host: '$HOST_NAME'"
            else
                err "web ui: HTTP $http_code from $WEB_URL: ${body:-unknown error}"
            fi
            SRV_OK=0
        fi
        return 1
    fi

    if ((!SRV_OK)); then log "web ui reachable ($WEB_URL)"; SRV_OK=1; fi
    SRV_HOLD=()
    local k v w
    while read -r k v w; do
        case $k in
            hold) [[ $v =~ ^[A-Za-z0-9][A-Za-z0-9@._+:-]*$ ]] && SRV_HOLD+=("$v") ;;
            run) SRV_RUN=1 ;;
            runsel) SRV_RUN=2 ;;
            item)
                if [[ $v =~ ^(pacman|apt|aur)$ && $w =~ ^[A-Za-z0-9][A-Za-z0-9@._+:-]*$ ]] \
                    || [[ $v == docker && $w =~ ^[A-Za-z0-9][A-Za-z0-9._/:-]*$ ]]; then
                    SRV_ITEMS+=("$v $w")
                fi ;;
        esac
    done <"$tmp_resp"
    rm -f "$tmp_resp"
    return 0
}

send_log() {
    [[ -z $WEB_URL || -z $TOKEN ]] && return 0
    local http_code
    http_code=$(tail -c 65536 "$LOG_FILE" | sed 's/^<[0-7]>//' | curl -sS --max-time 20 \
        -w "%{http_code}" -o /dev/null -X POST \
        -H "Authorization: Bearer $TOKEN" -H "X-Result: $1" \
        --data-binary @- "$WEB_URL/api/log?host=$HOST_NAME" 2>&1)
    if [[ $http_code != 200 ]]; then
        err "could not send log to web ui (HTTP ${http_code:-failed})"
    fi
}

# $1 = function to run: run_updates | run_selected
do_run() {
    local rc
    if [[ -n $WEB_URL ]]; then
        STATUS=running
        poll_server   # announce "running" (the web ui hands out no requests then), fetch holds
    fi
    local all=("${HOLD_PKGS[@]}" "${SRV_HOLD[@]}")
    export NU_IGNORE
    NU_IGNORE=$(IFS=,; echo "${all[*]}")
    [[ -n $NU_IGNORE ]] && log "held packages: $NU_IGNORE"

    "$1" 2>&1 | tee "$LOG_FILE"
    rc=${PIPESTATUS[0]}

    STATUS=idle
    if [[ -n $WEB_URL ]]; then
        refresh_all
        send_log "$( ((rc)) && echo failed || echo ok )"
    fi
}

# ---------------------------------------------------------------- main

load_config || exit 1

if [[ -n $WEB_URL ]]; then
    log "web ui: $WEB_URL as $HOST_NAME"
    poll_server   # register immediately with web UI so we appear as online
    refresh_fast
    poll_server
    if [[ $DOCKER_CHECK == yes ]]; then
        ( refresh_docker && poll_server ) >/dev/null 2>&1 &
    fi
fi
[[ $RUN_ON_BOOT == yes ]] && do_run run_updates

target=0
sig=""
while true; do
    load_config || { sleep 60; continue; }

    if [[ -n $WEB_URL ]]; then
        poll_server
        if ((SRV_RUN)); then
            if ((SRV_RUN == 2)); then
                SEL=("${SRV_ITEMS[@]}")
                log "selective update requested via web ui (${#SEL[@]} items)"
                do_run run_selected
            else
                log "update requested via web ui"
                do_run run_updates
            fi
            continue
        fi
        (($(date +%s) - last_check >= CHECK_INTERVAL)) && refresh_fast
        (($(date +%s) - last_docker_check >= DOCKER_CHECK_INTERVAL)) && refresh_docker
    fi

    if [[ -n $UPDATE_TIME ]]; then
        if [[ $sig != "$UPDATE_TIME|$UPDATE_DAYS" ]]; then
            sig="$UPDATE_TIME|$UPDATE_DAYS"
            target=0
        fi
        if ((target == 0)); then
            target=$(next_epoch) || { target=0; err "invalid UPDATE_TIME/UPDATE_DAYS in $CONFIG"; sleep 60; continue; }
            log "next run: $(date -d "@$target" '+%a %F %T')"
        fi
        if (($(date +%s) >= target)); then
            target=0
            do_run run_updates
            continue
        fi
    else
        sig=""
        target=0
    fi

    sleep "$POLL_INTERVAL"
done
